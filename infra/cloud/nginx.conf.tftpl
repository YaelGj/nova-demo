upstream nova {
    # Zone partagée : la répartition tourne entre tous les processus nginx.
    zone nova 64k;
%{ for nom in instances ~}
    server ${nom}:8000;
%{ endfor ~}
}

server {
    listen 80;
    location / {
        proxy_pass http://nova;
        # Montre quelle instance a répondu (démonstration de la répartition).
        add_header X-Instance $upstream_addr always;
    }
}
